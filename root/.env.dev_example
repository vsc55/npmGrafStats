INFLUX_URL=fake
INFLUX_BUCKET=local_bucket
INFLUX_ORG=local_org
INFLUX_TOKEN=local_token
INFLUX_RETRY_CONNECT=10
INFLUX_RETRY_DELAY=5

ABUSEIP_KEY=########################################################
ABUSEIP_CACHE_FILE="{workdir}/tests/data/abuseipdb_cache.json"
ABUSEIP_CACHE_EXPIRE=2880

PROXY_LOGS=TRUE
REDIRECT_LOGS=TRUE
MONITORING_LOGS=TRUE
INTERNAL_LOGS=TRUE
PUBLIC_LOGS=TRUE
MONITORING_FILE_PATH="{workdir}/tests/data/monitoring.txt"

GEO_ASN_DB_PATH="{workdir}/tests/data/GeoLite2-ASN.mmdb"
GEO_CITY_DB_PATH="{workdir}/tests/data/GeoLite2-City.mmdb"

LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=DEBUG
LOG_FILE="{workdir}/tests/data/logs/app.log"

NPM_LOGS_PATH={workdir}/tests/npm/logs

FAKE_SERVER=false
FAKE_SERVER_DEBUG=false

FAKE_CLIENT=true
FAKE_CLIENT_DEBUG=false
FAKE_CLIENT_FILE="{workdir}/tests/npm/logs/proxy-host-999_access.log"
FAKE_CLIENT_INTERVAL=10
FAKE_CLIENT_MIN_BATCH=2
FAKE_CLIENT_MAX_BATCH=5